---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
  <section class="editorial-hero">
    <figure class="editorial-hero-main" data-reveal>
      <img src="/images/work/photo-11-1600.webp" alt="A pole vaulter preparing to launch" width="2048" height="1365" fetchpriority="high">
      <figcaption>Between earth & sky · 2026</figcaption>
    </figure>

    <div class="editorial-intro" data-reveal>
      <p>
        Photographs of effort, friendship, and the moments in between—made by Megan Feng, a student photographer in Omaha.
      </p>
    </div>

    <figure class="editorial-hero-side" data-reveal>
      <img src="/images/work/photo-45-1600.webp" alt="A tennis player serving beneath a vivid blue sky" width="1365" height="2048">
      <figcaption>Match point · 2026</figcaption>
    </figure>
  </section>

  <section class="portfolio-index" id="work">
    <header class="portfolio-intro" data-reveal>
      <p class="micro-label">Selected portfolio · 2026</p>
      <h1>Stories I<br>couldn’t leave<br>behind.</h1>
      <p>Three ways of looking at the people and places around me.</p>
    </header>

    <article class="project-card project-sports" data-reveal>
      <a href="/work/sports">
        <figure>
          <img src="/images/work/photo-04-1600.webp" alt="A swimmer turning to breathe during a freestyle race" width="2048" height="1365" loading="lazy">
        </figure>
        <div class="project-meta">
          <span>01 / Sports</span>
          <h2>In motion</h2>
          <p>Swim, track, and tennis—the instant effort becomes visible.</p>
          <b>View series →</b>
        </div>
      </a>
    </article>

    <article class="project-card project-portraits" data-reveal>
      <a href="/work/portraits">
        <figure>
          <img src="/images/work/photo-27-1600.webp" alt="A student walking away down a quiet road with her arms out" width="2048" height="1735" loading="lazy">
        </figure>
        <div class="project-meta">
          <span>02 / Portraits</span>
          <h2>Being here</h2>
          <p>Friends, classmates, and a little room to be completely yourself.</p>
          <b>View series →</b>
        </div>
      </a>
    </article>

    <article class="project-card project-details" data-reveal>
      <a href="/work/details">
        <figure>
          <img src="/images/work/photo-42-1600.webp" alt="Camera equipment arranged on a white surface" width="2048" height="1365" loading="lazy">
        </figure>
        <div class="project-meta">
          <span>03 / Details</span>
          <h2>A closer look</h2>
          <p>The tools, gestures, and small pieces that complete a story.</p>
          <b>View series →</b>
        </div>
      </a>
    </article>
  </section>

  <section class="home-about" data-reveal>
    <div>
      <p class="micro-label">A little context</p>
      <h2>Hi, I’m Megan.</h2>
    </div>
    <div>
      <p>
        I’m a sophomore at Millard North High School. Sports taught me to anticipate, orchestra taught me to listen, and photography lets me keep the seconds that would otherwise disappear.
      </p>
      <a href="/about">More about me →</a>
    </div>
  </section>

  <section class="home-final-image" data-reveal>
    <img src="/images/work/photo-01-1600.webp" alt="A diver stretched horizontally above a swimming pool" width="2048" height="1365" loading="lazy">
    <p>Flight · 2026</p>
  </section>
</BaseLayout>
