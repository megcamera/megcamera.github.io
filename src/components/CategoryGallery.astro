---
import type {Photo} from '../data/gallery';

const {photos} = Astro.props as {photos: Photo[]};
---
<div class="category-gallery" data-gallery>
  {photos.map((photo, index) => {
    const id = String(photo.id).padStart(2, '0');
    return (
      <figure class:list={['gallery-frame', `gallery-frame-${index + 1}`]} data-reveal>
        <button
          type="button"
          class="gallery-open"
          data-photo={index}
          data-title={photo.title}
          data-alt={photo.alt}
          data-src={`/images/work/photo-${id}-1600.webp`}
          aria-label={`Open ${photo.title}`}
        >
          <img
            src={`/images/work/photo-${id}-1600.webp`}
            srcset={`/images/work/photo-${id}-800.webp 800w, /images/work/photo-${id}-1600.webp 1600w`}
            sizes="(max-width: 720px) 100vw, 33vw"
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading={index < 3 ? 'eager' : 'lazy'}
          >
        </button>
        <figcaption>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <span>{photo.title}</span>
        </figcaption>
      </figure>
    );
  })}
</div>

<dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
  <button class="lightbox-close" type="button" aria-label="Close photograph" data-close>Close ×</button>
  <button class="lightbox-arrow lightbox-prev" type="button" aria-label="Previous photograph" data-prev>←</button>
  <figure>
    <img src="" alt="" data-lightbox-image>
    <figcaption><span data-lightbox-number></span><span data-lightbox-title></span></figcaption>
  </figure>
  <button class="lightbox-arrow lightbox-next" type="button" aria-label="Next photograph" data-next>→</button>
</dialog>

<script>
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-photo]')];
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const title = dialog?.querySelector<HTMLElement>('[data-lightbox-title]');
  const number = dialog?.querySelector<HTMLElement>('[data-lightbox-number]');
  let current = 0;

  const showPhoto = (index: number) => {
    current = (index + triggers.length) % triggers.length;
    const trigger = triggers[current];
    if (!image || !title || !number) return;
    image.src = trigger.dataset.src ?? '';
    image.alt = trigger.dataset.alt ?? '';
    title.textContent = trigger.dataset.title ?? '';
    number.textContent = `${String(current + 1).padStart(2, '0')} / ${String(triggers.length).padStart(2, '0')}`;
  };

  triggers.forEach((trigger) => trigger.addEventListener('click', () => {
    showPhoto(Number(trigger.dataset.photo));
    dialog?.showModal();
    document.body.classList.add('lightbox-open');
  }));
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => showPhoto(current - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => showPhoto(current + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => document.body.classList.remove('lightbox-open'));
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(current - 1);
    if (event.key === 'ArrowRight') showPhoto(current + 1);
  });
</script>
