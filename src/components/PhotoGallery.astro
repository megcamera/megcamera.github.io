---
import {categoryLabels, photos} from '../data/gallery';
const categories = Object.entries(categoryLabels);
---
<section class="work-section" id="work" aria-labelledby="work-title">
  <div class="section-intro" data-reveal>
    <div>
      <p class="eyebrow">Selected work · 2026</p>
      <h2 id="work-title">People in motion.<br>Moments in between.</h2>
    </div>
    <p class="section-note">
      Swim meets, tennis courts, friends after school—and the split second when a familiar scene becomes something worth keeping.
    </p>
  </div>

  <div class="filter-bar" role="group" aria-label="Filter photographs" data-reveal>
    {categories.map(([key, label], index) => (
      <button class:list={{active: index === 0}} type="button" data-filter={key} aria-pressed={index === 0}>
        {label}
      </button>
    ))}
    <span class="photo-count"><b data-count>{photos.length}</b> frames</span>
  </div>

  <div class="photo-grid" data-gallery>
    {photos.map((photo, index) => (
      <article class:list={['photo-card', `photo-card-${index + 1}`]} data-category={photo.category} data-reveal>
        <button
          class="photo-open"
          type="button"
          data-photo={index}
          data-title={photo.title}
          data-alt={photo.alt}
          data-src={`/images/work/photo-${String(photo.id).padStart(2, '0')}-1600.webp`}
          aria-label={`Open ${photo.title}`}
        >
          <picture>
            <source
              srcset={`/images/work/photo-${String(photo.id).padStart(2, '0')}-800.webp 800w, /images/work/photo-${String(photo.id).padStart(2, '0')}-1600.webp 1600w`}
              sizes="(max-width: 680px) 100vw, (max-width: 1000px) 50vw, 40vw"
              type="image/webp"
            >
            <img
              src={`/images/work/photo-${String(photo.id).padStart(2, '0')}-1600.webp`}
              alt={photo.alt}
              width={photo.id === 45 ? 1365 : 2048}
              height={photo.id === 45 ? 2048 : 1365}
              loading={index < 3 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
            >
          </picture>
          <span class="photo-caption">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <b>{photo.title}</b>
            <i aria-hidden="true">View ↗</i>
          </span>
        </button>
      </article>
    ))}
  </div>
</section>

<dialog class="lightbox" data-lightbox aria-label="Photograph viewer">
  <button class="lightbox-close" type="button" aria-label="Close photograph" data-close>Close <span aria-hidden="true">×</span></button>
  <button class="lightbox-arrow lightbox-prev" type="button" aria-label="Previous photograph" data-prev>←</button>
  <figure>
    <img src="" alt="" data-lightbox-image>
    <figcaption>
      <span data-lightbox-number></span>
      <b data-lightbox-title></b>
    </figcaption>
  </figure>
  <button class="lightbox-arrow lightbox-next" type="button" aria-label="Next photograph" data-next>→</button>
</dialog>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-gallery] .photo-card')];
  const filterButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const count = document.querySelector('[data-count]');

  filterButtons.forEach((button) => button.addEventListener('click', () => {
    const filter = button.dataset.filter;
    let visible = 0;
    filterButtons.forEach((item) => {
      const active = item === button;
      item.classList.toggle('active', active);
      item.setAttribute('aria-pressed', String(active));
    });
    cards.forEach((card) => {
      const show = filter === 'all' || card.dataset.category === filter;
      card.toggleAttribute('hidden', !show);
      if (show) visible++;
    });
    if (count) count.textContent = String(visible);
  }));

  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const image = dialog?.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const title = dialog?.querySelector('[data-lightbox-title]');
  const number = dialog?.querySelector('[data-lightbox-number]');
  let current = 0;

  function showPhoto(index: number) {
    current = (index + cards.length) % cards.length;
    const trigger = cards[current].querySelector<HTMLButtonElement>('[data-photo]');
    if (!trigger || !image || !title || !number) return;
    image.src = trigger.dataset.src ?? '';
    image.alt = trigger.dataset.alt ?? '';
    title.textContent = trigger.dataset.title ?? '';
    number.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
  }

  cards.forEach((card) => {
    const trigger = card.querySelector<HTMLButtonElement>('[data-photo]');
    trigger?.addEventListener('click', () => {
      showPhoto(Number(trigger.dataset.photo));
      dialog?.showModal();
      document.body.classList.add('lightbox-open');
    });
  });
  dialog?.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-prev]')?.addEventListener('click', () => showPhoto(current - 1));
  dialog?.querySelector('[data-next]')?.addEventListener('click', () => showPhoto(current + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => document.body.classList.remove('lightbox-open'));
  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowLeft') showPhoto(current - 1);
    if (event.key === 'ArrowRight') showPhoto(current + 1);
  });
</script>
